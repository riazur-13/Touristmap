# Frontend configuration. Copy to `.env` and edit:
#
#   cp .env.example .env
#
# Vite reads `.env` automatically at startup. Restart `npm run dev` after
# changing it — these values are baked in at build time, not read at runtime.
#
# Only variables prefixed with VITE_ are exposed to browser code. That prefix is
# a safety feature: anything exposed this way ends up in the shipped JavaScript
# and is readable by anyone, so never put a secret in this file.

# Base URL of the recommendations backend, with no trailing slash.
#
# Leave it unset (or commented out) to run with no backend at all: the
# "You might also like" suggestions are then computed in the browser instead.
# The site is fully functional either way.
VITE_API_URL=http://localhost:8000
